<Window x:Class="HermitePad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermite Pad - Stylus Note App" 
        Height="800" Width="1200"
        WindowState="Maximized"
        Background="#F3F3F3">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Hermite Pad" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,20,0"/>
                    
                    <!-- File Operations -->
                    <Button x:Name="OpenButton" Content="📂 Open" Padding="10,5" Margin="5,0" Click="OpenButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="SaveButton" Content="💾 Save" Padding="10,5" Margin="5,0" Click="SaveButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="ExportPdfButton" Content="📄 Export PDF" Padding="10,5" Margin="5,0" Click="ExportPdfButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    
                    <Separator Style="{StaticResource VerticalSeparatorStyle}" Margin="10,0"/>
                    
                    <!-- Undo/Redo -->
                    <Button x:Name="UndoButton" Content="↶ Undo" Padding="10,5" Margin="5,0" Click="UndoButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="RedoButton" Content="↷ Redo" Padding="10,5" Margin="5,0" Click="RedoButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    
                    <Separator Style="{StaticResource VerticalSeparatorStyle}" Margin="10,0"/>
                    
                    <!-- Tools -->
                    <Button x:Name="InkButton" Content="✏️ Ink" Padding="10,5" Margin="5,0" Click="InkButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="EraserButton" Content="🧹 Eraser" Padding="10,5" Margin="5,0" Click="EraserButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="LassoButton" Content="⭕ Lasso" Padding="10,5" Margin="5,0" Click="LassoButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="BezierButton" Content="📐 Bezier" Padding="10,5" Margin="5,0" Click="BezierButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    
                    <Separator Style="{StaticResource VerticalSeparatorStyle}" Margin="10,0"/>
                    
                    <!-- Math Conversion -->
                    <Button x:Name="ConvertToMathButton" Content="🔢 Convert to Math" Padding="10,5" Margin="5,0" Click="ConvertToMathButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    
                    <Separator Style="{StaticResource VerticalSeparatorStyle}" Margin="10,0"/>
                    
                    <!-- Clear -->
                    <Button x:Name="ClearButton" Content="🗑️ Clear" Padding="10,5" Margin="5,0" Click="ClearButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>
                
                <!-- Tool Status -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToolStatusText" Text="Tool: Ink" Foreground="#34495E" Margin="5,0"/>
                    <TextBlock Text=" | " Foreground="#BDC3C7" Margin="5,0"/>
                    <TextBlock x:Name="SelectionInfoText" Text="" Foreground="#34495E" Margin="5,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            
            <!-- Canvas Area -->
            <Border Grid.Column="0" Background="White" Margin="10" CornerRadius="5" 
                    BorderBrush="#D5D8DC" BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <InkCanvas x:Name="MainInkCanvas" 
                               Background="White"
                               Width="2000" 
                               Height="2000"
                               MinWidth="800"
                               MinHeight="600"/>
                </ScrollViewer>
            </Border>
            
            <!-- Layers Panel -->
            <Border Grid.Column="1" Background="White" Margin="0,10,10,10" CornerRadius="5" 
                    BorderBrush="#D5D8DC" BorderThickness="1" Padding="10">
                <StackPanel>
                    <TextBlock Text="Layers" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#2C3E50"/>
                    
                    <ListBox x:Name="LayersList" Height="300" SelectionChanged="LayersList_SelectionChanged" 
                             BorderBrush="#BDC3C7" BorderThickness="1">
                        <ListBoxItem Content="Default Layer" IsSelected="True"/>
                    </ListBox>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="AddLayerButton" Content="➕ Add" Padding="8,4" Margin="0,0,5,0" 
                                Click="AddLayerButton_Click" Style="{StaticResource PanelButtonStyle}"/>
                        <Button x:Name="RemoveLayerButton" Content="➖ Remove" Padding="8,4" 
                                Click="RemoveLayerButton_Click" Style="{StaticResource PanelButtonStyle}"/>
                    </StackPanel>
                    
                    <Separator Margin="0,15,0,15" Background="#E0E0E0"/>
                    
                    <TextBlock Text="Properties" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="#2C3E50"/>
                    <TextBlock Text="Pressure Sensitivity: On" Margin="0,5" Foreground="#34495E"/>
                    <TextBlock Text="Smoothing: Enabled" Margin="0,5" Foreground="#34495E"/>
                    <TextBlock Text="Zoom: 100%" Margin="0,5" Foreground="#34495E"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#34495E" Padding="10,5">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="White"/>
        </Border>
    </Grid>
</Window>
